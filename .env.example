# Server-only runtime configuration. Never commit real credentials.

# Hosted edge defaults
DATABASE_DRIVER=d1
STORAGE_DRIVER=r2

# Self-hosted Node database adapter
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Self-hosted Alibaba Cloud OSS adapter
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
