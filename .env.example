# Server-only runtime configuration. Never commit real credentials.
# Local development can use project-scoped MySQL and local file storage.
# Production uses managed MySQL and Alibaba Cloud OSS.

# MySQL: accounts, sessions, workspaces, projects and canvases
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_MODE=required
# Base64-encoded ApsaraDB PEM CA chain. Keep the real value server-side only.
DB_SSL_CA_BASE64=

# Server-side secret encryption. Use at least 32 random bytes in production.
SECRET_ENCRYPTION_KEY=
# HMAC key for 15-minute Access Tokens. Use at least 32 random bytes.
ACCESS_TOKEN_SECRET=
# Independent HMAC key for short-lived plugin iframe grants. Keep this value
# stable across restarts and identical on every application instance.
PLUGIN_RUNTIME_TOKEN_SECRET=
# Internal scheduler authentication. Use a separate random secret.
RUNTIME_WORKER_TOKEN=
# Optional external scheduler label shown in operations health.
RUNTIME_SCHEDULER_NAME=

# Alibaba Cloud OSS: uploads, generated results and file versions
STORAGE_DRIVER=oss
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
# Used only when STORAGE_DRIVER=local in a non-production environment.
LOCAL_STORAGE_ROOT=.local-data/storage
# Personal workspace storage quota. Default: 10 GiB.
USER_STORAGE_QUOTA_BYTES=10737418240

# Optional. Raises GitHub API limits and allows server-side import of private
# repositories that the token can read. Never expose this value to browsers.
GITHUB_IMPORT_TOKEN=

# Extension supply-chain policy
REQUIRE_PACKAGE_SIGNATURES=true

# Production outbound API policy. HTTPS on port 443 is always allowed.
# Add exceptional TLS ports only when an administrator has reviewed them.
EXTERNAL_API_ALLOWED_PORTS=443

# Optional isolated CLI/Node/Python worker pool.
# The endpoint must be HTTPS in production and accept signed JSON jobs.
ISOLATED_WORKER_ENDPOINT=
ISOLATED_WORKER_TOKEN=
ISOLATED_WORKER_TIMEOUT_MS=60000
ISOLATED_WORKER_MAX_MEMORY_MB=512
ISOLATED_WORKER_MAX_CPU_MS=30000
ISOLATED_WORKER_MAX_WALL_MS=60000
# Read-only Package directory mounted by the isolated worker.
PACKAGE_ROOT=.wrangler/isolated-packages

# Legacy source used only during formal cutover. Keep these outside browser bundles.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
LEGACY_DB_SSL_MODE=required
LEGACY_DB_SSL_CA_BASE64=
LEGACY_OSS_REGION=
LEGACY_OSS_ACCESS_KEY_ID=
LEGACY_OSS_ACCESS_KEY_SECRET=
LEGACY_OSS_BUCKET=
LEGACY_OSS_ENDPOINT=
LEGACY_MIGRATION_MANIFEST=docs/baseline/legacy-migration-manifest.example.json

# Phone verification and password recovery
# In production, PHONE_LOOKUP_KEY and OTP_HASH_KEY must be long random secrets.
PHONE_LOOKUP_KEY=
OTP_HASH_KEY=
SMS_PROVIDER=aliyun
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
ALIYUN_SMS_PASSWORD_RESET_TEMPLATE_CODE=

# One-time server-side system administrator bootstrap
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_USERNAME=
SYSTEM_ADMIN_PHONE=
SYSTEM_ADMIN_DISPLAY_NAME=
SYSTEM_ADMIN_PASSWORD=
