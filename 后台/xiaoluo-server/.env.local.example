# =====================================================================
# XiaoLuo Agent OS server environment template
# Usage: copy this file to .env.local, then fill in real values
# =====================================================================

# Required for local / no-SSL database deployments (bypasses production SSL guard)
XIAOLUO_RUNTIME_ENV=1

# ===== MySQL (required) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xiaoluo
DB_PASSWORD=change-me
DB_NAME=xiaoluo_intent_os
# Local MySQL: disabled ; Alibaba Cloud RDS: required + CA cert below
DB_SSL_MODE=disabled
DB_SSL_CA_BASE64=

# ===== Aliyun OSS (required) =====
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me
OSS_BUCKET=change-me
OSS_ENDPOINT=

# ===== Secrets (required) =====
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRET_ENCRYPTION_KEY=change-me
ACCESS_TOKEN_SECRET=change-me
REQUIRE_PACKAGE_SIGNATURES=true
EXTERNAL_API_ALLOWED_PORTS=443

# ===== SMS =====
# development: verification code returned in API response (dev only)
# aliyun: required in production, fill the 4 items below
SMS_PROVIDER=development
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== Initial system admin (used by create-admin.bat only) =====
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_DISPLAY_NAME=admin
SYSTEM_ADMIN_PASSWORD=change-me
SYSTEM_ADMIN_PHONE=13800000000

# ===== Optional: Isolated Worker (plugin sandbox) =====
ISOLATED_WORKER_ENDPOINT=http://127.0.0.1:8788
ISOLATED_WORKER_TOKEN=change-me
RUNTIME_WORKER_TOKEN=change-me
