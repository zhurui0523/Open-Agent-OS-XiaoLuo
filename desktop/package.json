{
  "name": "xiaoluo-desktop",
  "version": "0.1.0",
  "description": "小逻云端智能画布桌面工作台",
  "author": "XiaoLuo",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "build": {
    "appId": "cn.luosheji.xiaoluo.desktop",
    "productName": "小逻",
    "electronVersion": "43.3.0",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "loading.html",
      "config.production.json",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/xiaoluo.ico",
      "executableName": "XiaoLuo",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "XiaoLuo-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小逻",
      "deleteAppDataOnUninstall": false
    }
  }
}
